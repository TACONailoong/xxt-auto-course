{
  "manifest_version": 3,
  "name": "学习通自动刷课助手",
  "version": "1.0.0",
  "description": "自动播放学习通视频课程，支持倍速播放和自动答题",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "*://*.chaoxing.com/*",
    "*://*.fx361.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.svg",
      "48": "icons/icon48.svg",
      "128": "icons/icon128.svg"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.chaoxing.com/*",
        "*://*.fx361.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  }
}
