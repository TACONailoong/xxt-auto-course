{
  "manifest_version": 3,
  "name": "学习通自动刷课助手",
  "version": "1.7.0",
  "description": "自动播放学习通视频课程，支持倍速、静音、弹窗答题、防挂机提示、跳过测验与自动切章",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.chaoxing.com/*",
    "*://*.fx361.com/*",
    "*://*.edu.cn/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "学习通自动刷课助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.chaoxing.com/*",
        "*://*.fx361.com/*",
        "*://*.edu.cn/*"
      ],
      "js": [
        "shared/defaults.js",
        "shared/dom.js",
        "content.js"
      ],
      "run_at": "document_end",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "xuexitong-auto-player@example.com",
      "strict_min_version": "115.0"
    }
  }
}
